# Не вставляйте реальные ключи в исходный код, инструкции агентов и историю.
PORT=4317
# Локальные данные. По умолчанию ./data/kontur.sqlite
# DATA_DIR=./data

# Автоматический поиск: официальный Places API 2ГИС.
DGIS_API_KEY=
# true ТОЛЬКО при наличии отдельного разрешения/договора, который допускает
# формирование, длительное хранение, обработку и экспорт вашей базы лидов.
# Обычный ключ/демо-ключ сам по себе такого права не даёт.
DGIS_STORAGE_LICENSE_CONFIRMED=false
# Включить только если ключу разрешено поле items.contact_groups.
DGIS_CONTACTS_ENABLED=false
# Интервал не меньше 1000 мс; учитывайте лимиты вашего тарифа.
DGIS_REQUEST_INTERVAL_MS=1500

# ИИ: none — модель не подключена; ollama — локальная модель; compatible —
# совместимый с Chat Completions сервер. Ни одна модель не получает инструменты.
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
# Для удалённого сервера дополнительно явно разрешите передачу выбранных данных.
AI_ALLOW_REMOTE=false
AI_TIMEOUT_MS=180000
